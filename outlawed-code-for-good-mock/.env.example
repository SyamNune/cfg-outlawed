# =========================================================================
# HACKATHON TEMPLATE - ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# 
# IMPORTANT:
# 1. Copy this file and rename it to '.env' in the root or individual folders.
# 2. NEVER commit the actual '.env' file containing real secrets to GitHub/Git.
# 3. Add '.env' to your '.gitignore' (already configured in this starter).
# =========================================================================

# --- Server Configurations ---
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database Placeholder ---
# e.g., mongodb://localhost:27017/hackathon or postgresql://user:pass@localhost:5432/db
DATABASE_URL=mongodb://localhost:27017/hackathon_placeholder

# --- Security & Authentication ---
# Generate a random secret for JWT or session encryption, e.g. using `openssl rand -base64 32`
AUTH_SECRET=your_jwt_auth_secret_change_me_tomorrow

# --- External Integration Placeholders ---
API_KEY=your_api_key_here
