# The model is downloaded once on first startup and then loaded from the local cache.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PORT=8001

# Optional: set to cpu to disable Apple Silicon acceleration.
# EMBEDDING_DEVICE=mps

# Local Docker services
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=outlawed
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_chunks

# Must remain inside this repository. Do not set this to a broad system folder.
SOURCE_PDF_DIR=../data/source-pdfs
